     // Apply color tint and alpha.
-    color *= innerCol;
-    return color;
+    return color * innerCol;
+}
+
+vec4 renderImage() {
+    // Calculate color from texture
+    vec2 pt = (paintMat * vec3(fpos, 1.0)).xy / extent;
+    return paintTexel(texture2D(tex, pt));
 }
 
