+    /// A scratch texture for a blur's horizontal pass, matching `info`'s
+    /// size, format and flags. Allocating and freeing one per blur (the
+    /// previous behaviour) costs a texture allocation, an FBO with its
+    /// stencil renderbuffer and a completeness check per blurred layer per
+    /// frame - on a Raspberry Pi a CMA allocation and a driver round trip
+    /// each. The few most recently used sizes are kept instead.
+    fn blur_scratch(&mut self, images: &mut ImageStore<GlTexture>, info: ImageInfo) -> ImageId {
+        let reusable = self.blur_scratches.iter().position(|&id| {
+            images.info(id).is_some_and(|scratch| {
+                scratch.width() == info.width()
+                    && scratch.height() == info.height()
+                    && scratch.format() == info.format()
+                    && scratch.flags() == info.flags()
+            })
+        });
+        if let Some(at) = reusable {
+            let id = self.blur_scratches.remove(at);
+            self.blur_scratches.push(id);
+            return id;
+        }
+        let id = images.alloc(self, info).expect("blur scratch texture");
+        self.blur_scratches.push(id);
+        if self.blur_scratches.len() > BLUR_SCRATCH_CAPACITY {
+            let evicted = self.blur_scratches.remove(0);
+            images.remove(self, evicted);
+        }
+        id
+    }
