+pub static FLAT_POINTS: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+pub static FLAT_CACHES: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(0);
+
+fn dump() -> bool {
+    static D: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *D.get_or_init(|| std::env::var_os("FEMTOVG_DUMP").is_some())
+}
+
+fn straddle_collect(p: [f32; 8], level: usize, tol: f32, k: f32, out: &mut Vec<[f32; 4]>) {
+    if level > 10 {
+        return;
+    }
+    let [x1, y1, x2, y2, x3, y3, x4, y4] = p;
+    let dx = x4 - x1;
+    let dy = y4 - y1;
+    let d2 = ((x2 - x4) * dy - (y2 - y4) * dx).abs();
+    let d3 = ((x3 - x4) * dy - (y3 - y4) * dx).abs();
+    if (d2 + d3) * (d2 + d3) < tol * (dx * dx + dy * dy) {
+        let len2 = dx * dx + dy * dy;
+        let (sx, sy) = if len2 > 0.0 {
+            // a + b, the control points' signed distances from the chord, times its length
+            let ab = ((x2 - x1) * -dy + (y2 - y1) * dx) + ((x3 - x1) * -dy + (y3 - y1) * dx);
+            let s = k * 0.5 * ab / len2;
+            (s * -dy, s * dx)
+        } else {
+            (0.0, 0.0)
+        };
+        out.push([x4, y4, sx, sy]);
+        return;
+    }
+    let (a, b) = split_cubic(p, 0.5);
+    straddle_collect(a, level + 1, tol, k, out);
+    straddle_collect(b, level + 1, tol, k, out);
+}
+
+fn straddle() -> Option<f32> {
+    static S: std::sync::OnceLock<Option<f32>> = std::sync::OnceLock::new();
+    *S.get_or_init(|| std::env::var("FEMTOVG_STRADDLE").ok().and_then(|v| v.parse::<f32>().ok()))
+}
+
+fn straddle2() -> Option<f32> {
+    static S: std::sync::OnceLock<Option<f32>> = std::sync::OnceLock::new();
+    *S.get_or_init(|| std::env::var("FEMTOVG_STRADDLE2").ok().and_then(|v| v.parse::<f32>().ok()))
+}
