+    /// Experiment: tesselate_bezier's bisection, each accepted chord's end held back until the next chord's shift is
+    /// known, then moved by the mean of the two (k times the mean of each chord's control distances).
+    fn tesselate_bezier_lean(&mut self, p: [f32; 8], level: usize, tol: f32, k: f32, dist_tol: f32) {
+        if level > 10 {
+            return;
+        }
+        let [x1, y1, x2, y2, x3, y3, x4, y4] = p;
+        let x12 = (x1 + x2) * 0.5;
+        let y12 = (y1 + y2) * 0.5;
+        let x23 = (x2 + x3) * 0.5;
+        let y23 = (y2 + y3) * 0.5;
+        let x34 = (x3 + x4) * 0.5;
+        let y34 = (y3 + y4) * 0.5;
+        let x123 = (x12 + x23) * 0.5;
+        let y123 = (y12 + y23) * 0.5;
+        let dx = x4 - x1;
+        let dy = y4 - y1;
+        let c2 = (x2 - x4) * dy - (y2 - y4) * dx;
+        let c3 = (x3 - x4) * dy - (y3 - y4) * dx;
+        let (d2, d3) = (c2.abs(), c3.abs());
+        let len2 = dx * dx + dy * dy;
+        if (d2 + d3) * (d2 + d3) < tol * len2 {
+            // c2, c3 are the control points' signed distances times the chord's length, to its right.
+            let s = if len2 > 0.0 { -k * 0.5 * (c2 + c3) / len2 } else { 0.0 };
+            let (sx, sy) = (s * -dy, s * dx);
+            if let Some([px, py, psx, psy]) = self.straddle_pending {
+                self.add_point(px + (psx + sx) * 0.5, py + (psy + sy) * 0.5, PointFlags::empty(), dist_tol);
+            }
+            self.straddle_pending = Some([x4, y4, sx, sy]);
+            return;
+        }
+        let x234 = (x23 + x34) * 0.5;
+        let y234 = (y23 + y34) * 0.5;
+        let x1234 = (x123 + x234) * 0.5;
+        let y1234 = (y123 + y234) * 0.5;
+        self.tesselate_bezier_lean([x1, y1, x12, y12, x123, y123, x1234, y1234], level + 1, tol, k, dist_tol);
+        self.tesselate_bezier_lean([x1234, y1234, x234, y234, x34, y34, x4, y4], level + 1, tol, k, dist_tol);
+    }
+
+    /// Experiment: bisect as tesselate_bezier does, then move each vertex inside the curve by the mean of its two
+    /// chords' shifts toward their control points, k times the mean of the control points' signed distances.
+    fn flatten_straddle(&mut self, p: [f32; 8], tol: f32, k: f32, flags: PointFlags, dist_tol: f32) {
+        let mut segs = std::mem::take(&mut self.straddle_scratch);
+        segs.clear();
+        straddle_collect(p, 0, tol, k, &mut segs);
+        let n = segs.len();
+        for i in 0..n {
+            let [x, y, sx, sy] = segs[i];
+            if i + 1 < n {
+                let [_, _, tx, ty] = segs[i + 1];
+                self.add_point(x + (sx + tx) * 0.5, y + (sy + ty) * 0.5, PointFlags::empty(), dist_tol);
+            } else {
+                self.add_point(x, y, flags, dist_tol);
+            }
+        }
+        self.straddle_scratch = segs;
+    }
