+    /// Experiment: split a cubic into as many pieces as its flatness bound asks for, not the next power of two.
+    fn flatten_nway(&mut self, p: [f32; 8], level: usize, flags: PointFlags, dev: f32, dist_tol: f32) {
+        let [x1, y1, x2, y2, x3, y3, x4, y4] = p;
+        let dx = x4 - x1;
+        let dy = y4 - y1;
+        let len = dx.hypot(dy);
+        // The curve lies within 3/4 of its farther control point's distance from the chord.
+        let far = if len > dist_tol {
+            ((x2 - x1) * dy - (y2 - y1) * dx).abs().max(((x3 - x1) * dy - (y3 - y1) * dx).abs()) / len
+        } else {
+            (x2 - x1).hypot(y2 - y1).max((x3 - x1).hypot(y3 - y1))
+        };
+        let bound = 0.75 * far;
+        if !(bound > dev) || level > 10 {
+            self.add_point(x4, y4, flags, dist_tol);
+            return;
+        }
+        let n = ((bound / dev).sqrt().ceil() as usize).clamp(2, 16);
+        let mut rest = p;
+        for i in 0..n {
+            let last = i + 1 == n;
+            let piece = if last {
+                rest
+            } else {
+                let t = 1.0 / (n - i) as f32;
+                let (a, b) = split_cubic(rest, t);
+                rest = b;
+                a
+            };
+            self.flatten_nway(piece, level + 1, if last { flags } else { PointFlags::empty() }, dev, dist_tol);
+        }
+    }
