+
+fn split_cubic(p: [f32; 8], t: f32) -> ([f32; 8], [f32; 8]) {
+    let lerp = |a: f32, b: f32| a + (b - a) * t;
+    let [x1, y1, x2, y2, x3, y3, x4, y4] = p;
+    let (x12, y12, x23, y23, x34, y34) = (lerp(x1, x2), lerp(y1, y2), lerp(x2, x3), lerp(y2, y3), lerp(x3, x4), lerp(y3, y4));
+    let (x123, y123, x234, y234) = (lerp(x12, x23), lerp(y12, y23), lerp(x23, x34), lerp(y23, y34));
+    let (xm, ym) = (lerp(x123, x234), lerp(y123, y234));
+    ([x1, y1, x12, y12, x123, y123, xm, ym], [xm, ym, x234, y234, x34, y34, x4, y4])
+}
+
+/// Experiment switches, read once: FEMTOVG_FLAT_DEV=d flattens n-way to a deviation of d px; FEMTOVG_TESS_TOL=t sets
+/// the bisection test's tolerance; FEMTOVG_JOIN_TOL=t the round joins' and caps' deviation.
+fn experiment() -> (Option<f32>, Option<f32>) {
+    static E: std::sync::OnceLock<(Option<f32>, Option<f32>)> = std::sync::OnceLock::new();
+    *E.get_or_init(|| {
+        let f = |k: &str| std::env::var(k).ok().and_then(|v| v.parse::<f32>().ok());
+        (f("FEMTOVG_FLAT_DEV"), f("FEMTOVG_TESS_TOL"))
+    })
+}
+
+fn join_tol(tess_tol: f32) -> f32 {
+    static J: std::sync::OnceLock<Option<f32>> = std::sync::OnceLock::new();
+    J.get_or_init(|| std::env::var("FEMTOVG_JOIN_TOL").ok().and_then(|v| v.parse::<f32>().ok())).unwrap_or(tess_tol)
+}
